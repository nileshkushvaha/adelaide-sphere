{
  "name": "@adelaide-sphere/mail",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-independent transactional email boundary shared by the API and the worker (SRS ENQ 004–005, MOD 002): SMTP transport with bounded timeouts, error classification and redacted failures.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src",
    "test": "vitest run"
  },
  "dependencies": {
    "nodemailer": "10.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "^1.58.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ]
}
