# Copy to packages/database/.env (git-ignored). Read by prisma.config.ts for the
# Prisma CLI (generate/validate/migrate) when DATABASE_URL is not already set in
# the environment. Encode reserved characters in user/password/database with
# percent-encoding (e.g. "p@ss" -> "p%40ss").
DATABASE_URL=mysql://APP_USER:APP_PASSWORD@127.0.0.1:3317/adelaide_sphere_dev

# Only for `prisma migrate dev` (needs a scratch database the app user may
# create tables in). Provisioned by infrastructure/mysql-init on a fresh volume.
SHADOW_DATABASE_URL=mysql://APP_USER:APP_PASSWORD@127.0.0.1:3317/adelaide_sphere_dev_shadow

# Migrations connect with the same URL and the same TLS rules as the API:
# append ?sslmode=verify-identity (or verify-ca&sslca=<path>) outside development.
