# Copy to apps/web/.env.local for local overrides. Next.js loads apps/web/.env*
# files itself when the server starts; a root .env is NOT read.
#
# Server-only origin of the NestJS API used by the /api/v1 rewrite in
# next.config.ts. Never expose it as NEXT_PUBLIC_*. Default shown.
API_ORIGIN=http://127.0.0.1:4001

# Absolute public origin for canonical URLs and metadata (SRS SEO 001). Optional
# in development (defaults to http://127.0.0.1:4000); required in production,
# where it is https://adelaidesphere.com.
SITE_ORIGIN=http://127.0.0.1:4000

# The published support address, phone number, branding, header contact bar and
# footer are no longer environment variables: they are edited in the admin
# application under Configuration → General settings and served by
# GET /api/v1/site/settings (SRS CFG 001).

# Cloudflare Turnstile *site* key (public half) for the review form. When unset,
# the form is not offered and explains that submissions are closed; the API
# separately requires its secret key. Obtain both from the client's Cloudflare
# account (decision D03).
TURNSTILE_SITE_KEY=

# Public base URL of processed media (MinIO locally, a CDN in production). It is
# read at build time to allow that single remote image origin; leave it unset
# and listings fall back to the placeholder image.
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:9020/adelaide-sphere-media

# Shared secret the worker presents to POST /api/revalidate when a publication
# change must purge cached pages (SRS CACHE 002). Generate a long random value
# per environment and set the same value as WEB_REVALIDATE_TOKEN for the worker.
# Leave empty in development to disable the endpoint (it then answers 503).
REVALIDATE_TOKEN=

# Review and AggregateRating structured data on business pages (SRS SEO 006).
# Off until the technical lead has verified Google's current eligibility rules
# for directory reviews and recorded the sign-off in docs/launch/seo-approval.md.
# Visible star ratings on the page do not depend on this flag.
REVIEW_RICH_RESULTS=false

# Staging or preview deployments only: true makes robots.txt disallow everything
# and every page noindex. Leave unset in production.
SITE_NOINDEX=
