# The worker reads the same variables as the API (DATABASE_URL, REDIS_URL,
# FIELD_ENCRYPTION_KEY, MAIL_TRANSPORT, SMTP_*, MAIL_FROM_ADDRESS, MAIL_FROM_NAME,
# SITE_ENQUIRY_RECIPIENT, MEDIA_*, WORKER_CONCURRENCY); see apps/api/.env.example
# for their meaning. Production requires MAIL_TRANSPORT=smtp with an
# authenticated TLS relay; the console transport is refused.
# Web tier purge endpoint (SRS CACHE 002). Set both, or neither in development.
# Production requires an https URL so publication changes reach the site.
WEB_REVALIDATE_URL=
WEB_REVALIDATE_TOKEN=

# Worker metrics and health (post-audit remediation). Unset, the worker has no
# HTTP surface at all. Set a port to serve GET /metrics and GET /health; the
# server binds to the loopback interface; binding wider is an explicit decision
# and is refused without METRICS_TOKEN (>= 32 characters).
WORKER_METRICS_PORT=
WORKER_METRICS_BIND=127.0.0.1
METRICS_TOKEN=
# debug | info | warn | error. Production defaults to info and logs one JSON
# object per line; development defaults to debug and logs readable lines.
LOG_LEVEL=

# Directory holding the scheduled backup state files, so the worker can publish
# backup freshness (SRS MON 002). Empty leaves those gauges unregistered.
BACKUP_STATE_DIR=

# AI Content text generation (Phase 1D). Server-side only: set it in the worker's
# environment or secret store, never in settings, source or chat. Leave empty to keep
# generation unavailable (requests fail before any provider call).
OPENAI_API_KEY=
# Image-only candidates (provider amendment 01). Same rules: server-side only, a
# separately billed API account (never a consumer plan or the Gemini free tier).
# Empty keeps the provider uncallable. Nothing is called without an approved price.
XAI_API_KEY=
GEMINI_API_KEY=
# AI operations run on their own queue with a small consumer (default 1, at most 4).
AI_WORKER_CONCURRENCY=1
