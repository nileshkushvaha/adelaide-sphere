{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BullMQ worker: durable enquiry delivery and future media/publishing jobs.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@adelaide-sphere/database": "workspace:*",
    "@adelaide-sphere/domain": "workspace:*",
    "@adelaide-sphere/mail": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "bullmq": "6.3.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "file-type": "22.0.2",
    "ioredis": "5.11.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "^1.58.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2"
  }
}
