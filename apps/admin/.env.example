# Copy to apps/admin/.env for local overrides (git-ignored). Read ONLY by
# vite.config.ts on the server side (dev server / preview); nothing here reaches
# the browser bundle. The browser always calls relative /api/v1 URLs.
#
# Origin of the NestJS API that the development proxy forwards /api/v1 to.
# Default shown. In production the reverse proxy routes /api/v1 itself.
ADMIN_API_PROXY_TARGET=http://127.0.0.1:4001

# Public website origin, used only to open article previews on the real site from the editor.
# Leave unset when the admin is served under /admin/ on the same origin as the site (production).
VITE_PUBLIC_SITE_ORIGIN=http://localhost:4000

# Public website address for the "View site" and "View listing" links. Leave unset in
# production, where the admin is served under /admin/ on the site's own origin.
VITE_PUBLIC_SITE_URL=http://localhost:4000
