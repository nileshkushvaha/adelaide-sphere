{
  "name": "admin",
  "version": "0.0.1",
  "private": true,
  "description": "Adelaide Sphere admin application (React, Refine, Ant Design). Served at /admin/.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4002 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4002 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --maxWorkers=2",
    "test:watch": "vitest --maxWorkers=2",
    "budget": "node scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "@ant-design/v5-patch-for-react-19": "1.0.3",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@adelaide-sphere/domain": "workspace:*",
    "@refinedev/antd": "6.0.3",
    "@refinedev/core": "5.0.12",
    "@refinedev/react-router": "2.0.4",
    "@tanstack/react-query": "5.102.8",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "antd": "5.29.3",
    "dayjs": "1.11.23",
    "diff": "9.0.0",
    "lucide-react": "1.41.0",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@adelaide-sphere/contracts": "workspace:*",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
