{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:integration": "vitest run --config ./vitest.config.integration.ts",
    "admin:bootstrap": "nest build && node dist/cli/bootstrap-admin.js",
    "admin:seed-rbac": "nest build && node dist/cli/bootstrap-admin.js --seed-only",
    "openapi:generate": "nest build && node dist/cli/generate-openapi.js",
    "taxonomy:seed": "nest build && node dist/cli/seed-taxonomy.js",
    "pages:seed": "nest build && node dist/cli/seed-pages.js",
    "menus:seed": "nest build && node dist/cli/seed-menus.js",
    "media:backfill-content": "nest build && node dist/cli/backfill-content-media.js",
    "blog:backfill-search-text": "nest build && node dist/cli/backfill-search-text.js",
    "routes:matrix": "nest build && node dist/cli/audit-routes.js",
    "authz:verify": "nest build && node dist/cli/verify-authorization.js",
    "auth:revoke-test-artifacts": "nest build && node dist/cli/revoke-auth-artifacts.js",
    "auth:artifacts:check": "nest build && node dist/cli/revoke-auth-artifacts.js --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@aws-sdk/s3-request-presigner": "3.1127.0",
    "@casl/ability": "7.0.1",
    "@adelaide-sphere/database": "workspace:*",
    "@adelaide-sphere/domain": "workspace:*",
    "@adelaide-sphere/mail": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.2",
    "@nestjs/swagger": "12.0.1",
    "@node-rs/argon2": "2.2.0",
    "bullmq": "6.3.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie": "2.0.1",
    "file-type": "22.0.2",
    "helmet": "^8.3.0",
    "ioredis": "5.11.1",
    "marked": "18.0.11",
    "otpauth": "9.5.2",
    "prom-client": "15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/sanitize-html": "2.16.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "express": "^5.2.1",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2"
  }
}
