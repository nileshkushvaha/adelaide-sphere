# Copy to apps/api/.env for local development. The API reads this file itself
# (path resolved relative to the app, so `pnpm dev:api` from the repo root and
# `pnpm start:dev` from apps/api behave identically). Real environment
# variables override values in this file. The file is ignored when NODE_ENV=test.
# Every variable below is optional; the defaults shown are what the code uses.

# development | test | production
NODE_ENV=development

# TCP port, integer 1-65535. Local convention: web 4000, api 4001, admin 4002.
PORT=4001

# MySQL connection for Prisma (required, no default). Use the non-root
# application user from infrastructure/.env; percent-encode reserved characters
# in user/password/database (e.g. "p@ss" -> "p%40ss").
DATABASE_URL=mysql://APP_USER:APP_PASSWORD@127.0.0.1:3317/adelaide_sphere_dev
# Transport security is part of the URL: ?sslmode=disabled (default, loopback
# development only), required (encrypted, unverified), verify-ca (add
# &sslca=<percent-encoded PEM path>) or verify-identity. Production refuses to
# start unless the mode verifies the server — see
# docs/security/dependency-advisories.md.
#   production: mysql://user:pw@db.internal:3306/adelaide_sphere?sslmode=verify-identity

# Let the MySQL driver fetch the server's RSA public key over the non-TLS local
# connection (MySQL 8 caching_sha2_password needs it after every server restart
# until the account is cached). true for local development only; production
# must use TLS to the database instead of enabling this.
DATABASE_ALLOW_PUBLIC_KEY_RETRIEVAL=true

# Trusted reverse-proxy hops (integer 0-10). 0 locally (no proxy trusted; the
# Next.js/Vite dev proxies are not trusted for client IP). Set 1 behind the
# production reverse proxy so client IPs for rate limits/audit are correct.
TRUST_PROXY=0

# --- Phase 9: administrator authentication ---------------------------------
# Redis (login throttling, distributed limits). Use the Compose Redis with the
# password from infrastructure/.env, percent-encoded: redis://:PASSWORD@127.0.0.1:6390/0
REDIS_URL=redis://:REDIS_PASSWORD@127.0.0.1:6390/0

# Application secret (>= 32 chars, random). Used for keyed hashes (e.g. the
# account-throttle key). Rotating it only resets throttle counters; sessions
# and passwords are hashed with their own random material and are unaffected.
# Generate: openssl rand -base64 48
APP_SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters

# Browser origins allowed to make session-authenticated admin mutations (CSRF
# origin check, SRS SEC 001). Comma-separated, no paths. Required in production.
TRUSTED_ORIGINS=http://127.0.0.1:4002,http://localhost:4002,http://127.0.0.1:4000,http://localhost:4000

# Session cookie policy (SRS AUTH 002). Secure must be true in production
# (HTTPS); false only for plain-http local development.
SESSION_COOKIE_SECURE=false
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Argon2id parameters (OWASP minimum m=19456 KiB, t=2, p=1). Benchmark per
# deployment (SRS AUTH 001) and raise memory/time where the hardware allows.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Base URL of the admin app for password-reset links (no trailing slash).
PUBLIC_ADMIN_URL=http://127.0.0.1:4002/admin

# Outbound mail for password resets and account set-up (SRS ENQ 005, D03):
#   none    — tokens are created but nothing is sent (delivery is reported as
#             unavailable); refused in production.
#   console — development only: prints the message, including the reset link,
#             to the API's stdout; refused in production.
#   smtp    — the provider-independent production transport: an authenticated
#             SMTP relay (Amazon SES, Postmark, Mailgun, SendGrid, Resend, Brevo
#             or a host-run relay all offer one). Locally it points at the
#             Compose Mailpit catcher, whose inbox is http://127.0.0.1:8035.
# Production requires smtp. The worker reads the same variables.
MAIL_TRANSPORT=smtp

# SMTP relay for MAIL_TRANSPORT=smtp. Local default: Mailpit, plaintext, no
# credentials. Production (docs/operations/deployment-vps.md §8.2):
#   SMTP_HOST=mail.adelaidesphere.com
#   SMTP_PORT=587            (STARTTLS, enforced in production)
#   SMTP_SECURE=false        (true only for implicit TLS on 465)
#   SMTP_USER=smtp@adelaidesphere.com
#   SMTP_PASSWORD=           from the secret store — never in this file
SMTP_HOST=127.0.0.1
SMTP_PORT=1035
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Serve the OpenAPI document at /api/v1/openapi.json (development tooling).
OPENAPI_ENABLED=false

# 32 random bytes, base64 (44 chars), for AES-256-GCM encryption of sensitive
# fields (TOTP secrets, SRS DAT 002/AUTH 003). Required. Rotation requires
# re-encrypting stored fields; keep old keys until that migration has run.
# Generate: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-output

# Public site origin (canonical links, expected Turnstile hostname). Required in
# production; defaults to unset locally.
# Production is https://adelaidesphere.com; the local default is shown here.
PUBLIC_SITE_URL=http://127.0.0.1:4000

# Cloudflare Turnstile secret key for public form verification (SRS SEC 002).
# Required in production. Without it the API refuses public submissions with a
# 503 rather than accepting unverified content; it never silently bypasses the
# check. Obtain it from the client's Cloudflare account (decision D03).
TURNSTILE_SECRET_KEY=

# Version recorded with each acknowledgement of the review guidelines and
# privacy notice (SRS PRIV 001). Change it when those documents change.
SUBMISSION_TERMS_VERSION=2026-09-01

# Where general site enquiries (POST /api/v1/contact) are delivered. Without it
# general enquiries are refused rather than dropped; business enquiries use the
# listing's own private enquiry email.
SITE_ENQUIRY_RECIPIENT=

# Verified sender for all outbound mail (SRS ENQ 005). Required with the smtp
# transport and in production; the visitor's address is only ever used as
# Reply-To. The local value below is deliberately a non-routable domain and is
# only ever seen in the Mailpit inbox.
# Production: noreply@adelaidesphere.com.
MAIL_FROM_ADDRESS=no-reply@adelaidesphere.local

# Display name on the From header (SMTP and Resend), at most 78 characters.
MAIL_FROM_NAME=Adelaide Sphere

# Worker concurrency (apps/worker), 1-20.
WORKER_CONCURRENCY=2

# Object storage for media (SRS MED 002). Locally this is the Compose MinIO
# service; production uses the provider endpoint and a least-privilege key.
MEDIA_S3_ENDPOINT=http://127.0.0.1:9020
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_QUARANTINE_BUCKET=adelaide-sphere-quarantine
MEDIA_PUBLIC_BUCKET=adelaide-sphere-media
# Public base URL of processed variants (a CDN in production).
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:9020/adelaide-sphere-media

# Pooled database connections for this API replica (SRS OPS 003). Keep
# (api replicas + worker replicas) × limit below the server's max_connections,
# with headroom for migrations and admin sessions. The default of 20 sustains
# the NFR 003 capacity profile on a single replica.
DATABASE_CONNECTION_LIMIT=20

# Metrics exposition (SRS MON 001, post-audit remediation). GET /metrics sits
# outside /api/v1 and is not in the OpenAPI document. Unset, it answers only
# requests from the loopback interface — a scraper sidecar on the same host.
# Set it (>= 32 characters) when the scraper is off-host; anything without the
# exact bearer token receives 404.
METRICS_TOKEN=
