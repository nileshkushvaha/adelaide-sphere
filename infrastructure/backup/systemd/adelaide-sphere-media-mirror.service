# Hourly off-site mirror of the media bucket (SRS BACK 001: media protection
# with replication lag of at most one hour).
#
# The database backup contains no uploaded files. Without this, losing the
# server loses every photograph on the site.
[Unit]
Description=Mirror Adelaide Sphere media to off-site storage (SRS BACK 001)
Documentation=file:/srv/adelaide-sphere/current/infrastructure/backup/README.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
OnFailure=adelaide-sphere-media-mirror-failed.service

[Service]
Type=oneshot
User=deploy
Group=deploy
UMask=0077
Environment=BACKUP_ROOT=/srv/adelaide-sphere
ExecStart=/srv/adelaide-sphere/current/infrastructure/backup/mirror-media.sh
TimeoutStartSec=3000
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
