# Local infrastructure credentials — copy to infrastructure/.env and replace
# every placeholder. infrastructure/.env is git-ignored; never commit it.
#
# MySQL: the MYSQL_* values are applied by the image ONLY when the data volume
# is created (first start). Editing them afterwards does not change the
# existing root/app users; you would need to alter them in MySQL or recreate
# the volume (destructive).

# Host ports (loopback only). 3317 and 6390 are the defaults because a native
# MySQL (3306) and another project's Redis container (6379) commonly occupy the
# standard ports on developer machines.
MYSQL_HOST_PORT=3317
REDIS_HOST_PORT=6390
# Adminer (browser database UI, development only)
ADMINER_HOST_PORT=8092
# MinIO S3-compatible storage (API and web console). 9020/9021 avoid 9000,
# which php-fpm and other local services commonly use.
MINIO_HOST_PORT=9020
MINIO_CONSOLE_PORT=9021
# Mailpit local SMTP catcher (SMTP listener and browser inbox). 1025/8025 are
# Mailpit's own defaults and are not used by other local services here.
MAILPIT_SMTP_PORT=1035
MAILPIT_UI_PORT=8035

# MySQL root — only used inside the container / for admin tasks.
MYSQL_ROOT_PASSWORD=change-me-root

# Development database and the non-root application user (granted only on
# this database).
MYSQL_DATABASE=adelaide_sphere_dev
MYSQL_USER=adelaide_sphere
MYSQL_PASSWORD=change-me-app

# Redis AUTH password.
REDIS_PASSWORD=change-me-redis

# MinIO root credentials. The API and worker use these locally as their S3
# access key and secret; production uses a least-privilege key from the real
# provider instead (SRS MED 002, SEC 004).
MINIO_ROOT_USER=change-me-minio
MINIO_ROOT_PASSWORD=change-me-minio-secret
